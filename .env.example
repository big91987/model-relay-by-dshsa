# Copy to .env and replace every placeholder. Never commit the real .env.

# Signs admin sessions and encrypts upstream channel keys. Keep it stable.
SECRET_KEY=replace-with-a-long-random-string

# Initial admin account, used only when the database has no user yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

PORT=8080

# Exact SQLite file path. Leave unset to keep using DATA_DIR/gateway.db.
# SQLITE_PATH=/var/lib/model-relay/gateway.db

# HTTP listen host. Leave unset for all interfaces (normal deployment);
# TEST_MODE=1 defaults to 127.0.0.1. Set 127.0.0.1 explicitly for a local trial.
# HOST=127.0.0.1

# PostgreSQL mode. Leave DATABASE_URL empty to keep the SQLite file in DATA_DIR.
# For docker-compose.postgres.yml, .env also needs the four POSTGRES_* values
# below and a DATABASE_URL reachable from the gateway container:
# DATABASE_URL=postgres://relay@postgres:5432/exp_model_relay?sslmode=disable
# PGPASSWORD=replace-with-the-same-database-password

# Local test environment only: defaults the initial admin to admin/admin and
# opens the console in Chinese. Never enable this for a production deployment.
# TEST_MODE=1

# Used by docker-compose.postgres.yml. Choose a URL-safe password.
POSTGRES_DB=exp_model_relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=replace-with-a-strong-database-password
